# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Local rubric-verification baselines (ignored, see scripts/verify-presets.ts)
/.tmp-baselines

# Critique captures — session-local screenshot evidence, regenerable
/.tmp-critique

# Release acceptance manifest — the seal's own output. A committed copy would
# always name its parent commit, so it is regenerated per run instead
# (see docs/release-acceptance.md)
/docs/release-acceptance-manifest.json

.test-snapshots

# User compositions — local-only, never committed (ADR-0032)
/user-compositions

# User image assets — content-addressed local uploads, never committed
/user-assets

# Composition posters — rendered picker previews, regenerable, never committed
/.posters

# Reference backdrop stills — local preview aids for judging overlays over
# footage (ADR-0034 §7); personal footage frames, never committed
/static/backdrops

# Cross-process Dex write coordination
/.dex/swamp-repository-write.lock

# BEGIN swamp managed section - DO NOT EDIT

# Runtime data (not needed in version control)
.swamp/

# Local extension sources (developer-specific, not shared)
.swamp-sources.yaml

# Claude Code configuration (managed by swamp)
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
# END swamp managed section
