		"audit:planning": "node --experimental-strip-types scripts/audit-planning-state.ts",
		"test:structural": "node --test scripts/check-discoverability.test.mjs scripts/check-legacy-name-dispositions.test.mjs scripts/check-verification-spawn-hygiene.test.mjs src/lib/utils/pack-registry-source.test.mjs && node --experimental-strip-types scripts/audit-starter-template-coverage.ts && node --experimental-strip-types --test scripts/planning-state-checks.test.ts scripts/check-dex-landing.test.ts scripts/change-impact-classifier.test.ts scripts/layout-contract-matrix.test.ts scripts/preset-validation-command.test.ts scripts/derive-gfx-render-matrix-manifest.test.ts scripts/browser-render-verification.test.ts scripts/probe-banding.test.ts scripts/probe-edge-aa.test.ts && node scripts/test-structural.mjs",
		"test:discoverability": "node --test scripts/check-discoverability.test.mjs",
		"test:watch": "vp test --project node --project dom",
		"prepare": "svelte-kit sync || echo ''",
		"gen:identity": "node --experimental-strip-types scripts/generate-gfx-identity-assets.ts",
		"gen:pack-showcase": "node --experimental-strip-types scripts/generate-pack-showcase.ts",
		"capture:pack-dresses": "node --experimental-strip-types scripts/capture-pack-dresses.ts",
		"probe:docs-showcase": "node scripts/probe-docs-showcase.mjs",
		"gen:sounds": "node scripts/gen-foley-sounds.mjs",
		"capture:workspace-loop": "node --experimental-strip-types scripts/cdp-capture-workspace-loop.ts",
		"capture:posters": "node --experimental-strip-types scripts/cdp-capture-composition-posters.ts",
		"refresh:google-fonts": "node scripts/refresh-google-fonts-catalog.mjs",
		"check": "vp run check:run",
		"check:run": "vp run check:types && vp run lint:app && vp run check:policy",
		"check:discoverability": "node scripts/check-discoverability.mjs",
		"check:names": "node scripts/check-legacy-name-dispositions.mjs",
		"check:spawn-hygiene": "node scripts/check-verification-spawn-hygiene.mjs",
		"check:dex-landing": "node --experimental-strip-types scripts/check-dex-landing.ts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --incremental --watch",
		"lint": "vp run lint:app",
		"format": "vp fmt .",
		"gen:schema": "node --experimental-strip-types scripts/export-preset-schema.ts && node --experimental-strip-types scripts/export-film-schema.ts",
		"gfx": "node --experimental-strip-types scripts/gfx.ts",
		"verify:identity": "node --experimental-strip-types scripts/verify-gfx-identity-legibility.ts",
		"verify-presets": "node --experimental-strip-types scripts/verify-presets.ts",
		"verify:layout-contract": "node --experimental-strip-types scripts/run-gfx-layout-contract-matrix.mjs",
		"verify:browser-render": "node --experimental-strip-types scripts/verify-browser-render-matrix.mjs",
		"verify:export-decode:public-matrix": "node --experimental-strip-types scripts/probe-public-export-decode-matrix.ts",
		"verify:production-image": "node --experimental-strip-types scripts/verify-production-image.ts",
		"verify:production-demo": "node --experimental-strip-types scripts/verify-production-demo-serving.ts",
		"verify:authoring-scenario": "node --experimental-strip-types scripts/run-gfx-authoring-scenario.ts",
		"seal:release-acceptance": "node --experimental-strip-types scripts/seal-release-acceptance-manifest.ts"
	},
