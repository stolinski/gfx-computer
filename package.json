{
	"name": "gfx",
	"private": true,
	"version": "0.0.1",
	"license": "FSL-1.1-ALv2",
	"type": "module",
	"packageManager": "pnpm@11.1.3",
	"scripts": {
		"dev": "vp dev",
		"dev:hosted": "PUBLIC_GFX_HOSTED=1 PUBLIC_GFX_COMPOSITION_STORE=browser GFX_RELEASE=gfx@dev-hosted vp dev",
		"build": "vp build",
		"build:hosted": "PUBLIC_GFX_HOSTED=1 vp build",
		"preview": "vp preview --port 4173",
