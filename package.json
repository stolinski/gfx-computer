		"@fontsource/space-mono": "^5.3.0",
		"@sentry/sveltekit": "^10.76.2",
		"@shikijs/magic-move": "^4.5.0",
		"d3-force": "3.0.0",
		"d3-hierarchy": "3.1.2",
		"d3-sankey": "0.12.3",
		"earcut": "^3.2.4",
		"gsap": "^3.15.0",
		"html2canvas": "1.4.1",
		"mediabunny": "^1.62.1",
		"playwright": "^1.64.1",
		"shiki": "^4.5.0",
		"typegpu": "^0.11.9",
		"wgpu-matrix": "^3.4.2",
		"zod": "^4.6.7"
	}
