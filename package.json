		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/fontkit": "^2.0.9",
		"@types/node": "^26.1.1",
		"@types/pngjs": "^6.0.5",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"fontkit": "^2.0.4",
		"globals": "^17.7.0",
		"jsdom": "^30.0.1",
		"pngjs": "^7.0.0",
		"polygon-clipping": "0.15.7",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.2",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.63.0",
		"vite": "^8.1.4",
		"vitest": "~4.1.0",
		"wrangler": "4.128.0"
	},
	"dependencies": {
		"@drop-in/graffiti": "^4.30.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"@fontsource-variable/rubik": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@fontsource/archivo": "^5.2.8",
		"@fontsource/eb-garamond": "^5.2.7",
		"@fontsource/geist": "^5.2.9",
		"@fontsource/geist-mono": "^5.2.8",
		"@fontsource/inter": "^5.2.8",
		"@fontsource/jetbrains-mono": "^5.2.8",
		"@fontsource/old-standard-tt": "^5.2.8",
		"@fontsource/playfair-display": "^5.2.8",
		"@fontsource/rubik": "^5.3.0",
		"@fontsource/space-grotesk": "^5.2.10",
		"@fontsource/space-mono": "^5.2.9",
		"@sentry/sveltekit": "^10.67.0",
		"earcut": "^3.2.3",
		"gsap": "^3.15.0",
		"html2canvas": "1.4.1",
		"mediabunny": "^1.50.8",
		"playwright": "^1.61.1",
		"typegpu": "^0.11.9",
		"wgpu-matrix": "^3.4.2",
		"zod": "^4.4.3"
	}
}
