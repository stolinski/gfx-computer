		"deploy:hosted": "scripts/deploy-hosted-origin.sh",
		"verify:hosted-export": "node --experimental-strip-types scripts/verify-hosted-export.ts",
		"test": "vp run test:unit",
		"test:run": "vp test run --project node --project dom",
		"test:changed": "vp test run --project node --project dom --changed --passWithNoTests",
		"test:integration": "vp test run --project integration",
		"test:all": "vp test run",
		"test:browser": "node scripts/test-browser-render.mjs",
		"probe:standard-browser": "node scripts/probe-standard-browser-rendering.mjs",
