{
	"name": "gfx",
	"private": true,
	"version": "0.0.1",
	"license": "FSL-1.1-ALv2",
	"type": "module",
	"packageManager": "pnpm@11.1.3",
	"scripts": {
		"dev": "vite dev",
		"dev:hosted": "PUBLIC_GFX_HOSTED=1 PUBLIC_GFX_COMPOSITION_STORE=browser GFX_RELEASE=gfx@dev-hosted vite dev",
		"build": "vite build",
		"build:hosted": "PUBLIC_GFX_HOSTED=1 vite build",
		"preview": "vite preview --port 4173",
		"preview:hosted": "wrangler dev --var GFX_RELEASE:gfx@preview-hosted",
		"deploy:hosted": "scripts/deploy-hosted-origin.sh",
		"verify:hosted-export": "node --experimental-strip-types scripts/verify-hosted-export.ts",
		"test": "vitest run",
		"test:browser": "node scripts/test-browser-render.mjs",
		"probe:standard-browser": "node scripts/probe-standard-browser-rendering.mjs",
		"eval:webmcp": "node --experimental-strip-types scripts/webmcp-agent-browser-eval.ts",
		"probe:public-runtime": "node --experimental-strip-types scripts/probe-public-runtime.ts",
		"probe:browser-session": "node --experimental-strip-types scripts/probe-browser-session-integrity.ts",
		"probe:stale-build-recovery": "node --experimental-strip-types scripts/probe-stale-build-recovery.ts",
		"probe:user-pack-render": "node --experimental-strip-types scripts/probe-user-pack-render.ts",
		"probe:text-animation-weight": "node --experimental-strip-types scripts/probe-text-animation-variable-weight.ts",
		"audit:timing": "node --experimental-strip-types scripts/audit-timing-coverage.ts",
		"audit:starter-templates": "node --experimental-strip-types scripts/audit-starter-template-coverage.ts",
		"audit:tracking": "node --experimental-strip-types scripts/audit-tracking-coverage.ts",
		"audit:parity": "node --experimental-strip-types scripts/audit-inspector-parity.ts",
		"audit:webmcp-parity": "node --experimental-strip-types scripts/audit-webmcp-operation-parity.ts",
		"audit:planning": "node --experimental-strip-types scripts/audit-planning-state.ts",
		"test:structural": "node --test scripts/check-discoverability.test.mjs scripts/check-legacy-name-dispositions.test.mjs scripts/check-verification-spawn-hygiene.test.mjs src/lib/utils/pack-registry-source.test.mjs && node --experimental-strip-types scripts/audit-starter-template-coverage.ts && node --experimental-strip-types --test scripts/planning-state-checks.test.ts scripts/change-impact-classifier.test.ts scripts/layout-contract-matrix.test.ts scripts/preset-validation-command.test.ts scripts/derive-gfx-render-matrix-manifest.test.ts scripts/browser-render-verification.test.ts && node scripts/test-structural.mjs",
		"test:discoverability": "node --test scripts/check-discoverability.test.mjs",
		"test:watch": "vitest",
		"prepare": "svelte-kit sync || echo ''",
		"gen:identity": "node --experimental-strip-types scripts/generate-gfx-identity-assets.ts",
		"gen:sounds": "node scripts/gen-foley-sounds.mjs",
		"capture:workspace-loop": "node --experimental-strip-types scripts/cdp-capture-workspace-loop.ts",
		"capture:posters": "node --experimental-strip-types scripts/cdp-capture-composition-posters.ts",
		"refresh:google-fonts": "node scripts/refresh-google-fonts-catalog.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run lint && npm run check:discoverability && npm run check:names && npm run check:spawn-hygiene",
		"check:discoverability": "node scripts/check-discoverability.mjs",
		"check:names": "node scripts/check-legacy-name-dispositions.mjs",
		"check:spawn-hygiene": "node scripts/check-verification-spawn-hygiene.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"gen:schema": "node --experimental-strip-types scripts/export-preset-schema.ts",
		"gfx": "node --experimental-strip-types scripts/gfx.ts",
		"verify:identity": "node --experimental-strip-types scripts/verify-gfx-identity-legibility.ts",
		"verify-presets": "node --experimental-strip-types scripts/verify-presets.ts",
		"verify:layout-contract": "node --experimental-strip-types scripts/run-gfx-layout-contract-matrix.mjs",
		"verify:browser-render": "node --experimental-strip-types scripts/verify-browser-render-matrix.mjs",
		"verify:export-decode:public-matrix": "node --experimental-strip-types scripts/probe-public-export-decode-matrix.ts",
		"verify:production-image": "node --experimental-strip-types scripts/verify-production-image.ts",
		"verify:production-demo": "node --experimental-strip-types scripts/verify-production-demo-serving.ts",
		"verify:authoring-scenario": "node --experimental-strip-types scripts/run-gfx-authoring-scenario.ts",
		"seal:release-acceptance": "node --experimental-strip-types scripts/seal-release-acceptance-manifest.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
