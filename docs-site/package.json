{
	"name": "gfx-docs",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 7264",
		"build": "npm run clean:worker && wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 7264",
		"deploy": "vite build && wrangler deploy",
		"gen": "npm run clean:worker && wrangler types",
		"clean:worker": "rm -rf .svelte-kit/cloudflare",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^25.9.9",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"wrangler": "^4.152.0"
	},
	"dependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@shikijs/markdown-it": "^3.23.0",
		"markdown-it": "^14.3.3",
		"markdown-it-anchor": "^9.2.1",
		"shiki": "^3.23.0"
	}
}
